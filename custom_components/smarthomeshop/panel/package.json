{
  "name": "smarthomeshop-panel",
  "version": "1.11.0",
  "description": "SmartHomeShop Configurator Panel for Home Assistant",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:prod": "npm run build && npm run copy",
    "copy": "cp dist/smarthomeshop-panel.js ../www/smarthomeshop-panel.js",
    "test:furniture": "node --test test/furniture-rotation.test.mjs",
    "test:quiet-hours": "node --test test/sps30-quiet-hours.test.mjs",
    "watch": "rollup -c -w"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
